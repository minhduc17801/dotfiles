layout {

    focus-ring {
        active-color   "#c8c2e7"
        inactive-color "#141315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#c8c2e7"
        inactive-color "#141315"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#c8c2e7"
        inactive-color "#464260"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c8c2e780"
    }
}

recent-windows {
    highlight {
        active-color "#c8c2e7"
        urgent-color "#ffb4ab"
    }
}
