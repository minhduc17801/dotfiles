window-rule {
  // Rounded corners for a modern look.
  geometry-corner-radius 12

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

// Floating Noctalia settings window (v5).
// draw-border-with-background false: focus ring/border must not fill behind
// the translucent Settings window (otherwise active-color shows through).
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { fixed 1080; }
  default-window-height { fixed 920; }
  draw-border-with-background false
}

// Stationary wallpaper on the backdrop (Noctalia v5).
layer-rule {
  match namespace="^noctalia-wallpaper$"
  place-within-backdrop true
}

/* Apps: blur them all without xray so it looks more realistic. */
window-rule {
  background-effect {
    blur true
    xray false
  }
}

/* Noctalia v5 surfaces — disable xray (blur regions published automatically). */
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
  }
}

/* Noctalia window switcher */
layer-rule {
  match namespace="noctalia-window-switcher"
  background-effect {
    blur true
    xray false
  }
}

blur {
  passes 2        // more passes = stronger blur (default: 3)
  offset 3.0      // sample distance per pass (default: 3.0)
  noise 0.03      // grain overlay (default: 0.02)
  saturation 1.0  // color saturation boost (default: 1.5)
}
